PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://localhost:8083,http://localhost:19006

MARKET_DATA_PROVIDER=
MARKET_DATA_BASE_URL=
# Use the data.go.kr decoding serviceKey. Keep it server-only.
MARKET_DATA_API_KEY=
MARKET_DATA_APP_SECRET=
MARKET_DATA_ALLOW_MOCK_FALLBACK=true
MARKET_DATA_TIMEOUT_MS=5000
MARKET_DATA_CACHE_MAX_ENTRIES=500

OPENDART_API_KEY=
OPENDART_BASE_URL=https://opendart.fss.or.kr
OPENDART_TIMEOUT_MS=7000
OPENDART_ARCHIVE_TIMEOUT_MS=15000
OPENDART_INDEX_CACHE_DIR=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=35000
OPENAI_MAX_OUTPUT_TOKENS=12000
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=600000

FILING_PERSISTENCE_ENABLED=false
DATABASE_URL=
DATABASE_POOL_MAX=4
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_SSL_MODE=disable

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
