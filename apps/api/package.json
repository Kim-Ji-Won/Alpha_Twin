{
  "name": "@alpha-twin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --migrations-schema public --migrations-table pgmigrations --single-transaction",
    "db:migrate:down": "node-pg-migrate down 1 --migrations-dir migrations --migrations-schema public --migrations-table pgmigrations --single-transaction",
    "db:migrate:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format timestamp --migrations-dir migrations",
    "test:db": "tsx --test integration-test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "openai": "^6.49.0",
    "pg": "8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "@types/yauzl": "^3.4.0",
    "node-pg-migrate": "9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
